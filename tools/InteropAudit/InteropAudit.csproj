<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Nested synthetic fixtures are a separate test project, not part of
         the runtime audit. Exclude their source and generated obj files. -->
    <Compile Remove="Tests/**/*.cs" />
  </ItemGroup>
</Project>
